		"@dallay/organiza-darwin-x64": "0.1.0",
		"@dallay/organiza-linux-arm64": "0.1.0",
		"@dallay/organiza-linux-x64": "0.1.0",
		"@dallay/organiza-windows-arm64": "0.1.0",
		"@dallay/organiza-windows-x64": "0.1.0"
	},
	"engines": {
		"node": ">=18"
	}
